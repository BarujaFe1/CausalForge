# CausalForge — environment example (no secrets)
# Copy to .env and adjust locally. Never commit real credentials.

# Frontend (Vercel web project)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend (Vercel API project) — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

API_HOST=127.0.0.1
API_PORT=8000
